# Auto-detect text files and normalise line endings to LF
* text=auto eol=lf

# Source files
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.properties text eol=lf

# Gradle wrapper — executable script + binary jar
gradlew  text eol=lf
*.jar    binary

# ML model exports (binary; must never be line-ending normalized)
*.onnx   binary
*.nb     binary

# Images
*.jpg    binary
*.jpeg   binary
*.png    binary
*.webp   binary
*.gif    binary
*.ico    binary
